# Golden-Agent Execution Mode: local | cloud | hybrid
GOLDEN_EXECUTION_MODE=hybrid

# Local Ollama Endpoint
GOLDEN_OLLAMA_BASE_URL=http://localhost:11434
GOLDEN_TIER1_LOCAL_MODEL=ollama/qwen2.5:7b
GOLDEN_TIER2_LOCAL_MODEL=ollama/qwen2.5-coder:32b
GOLDEN_TIER3_LOCAL_MODEL=ollama/deepseek-r1:32b

# Cloud Provider API Keys (optional if running 100% local)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=

# Gateway Security Token (leave blank for open local dev, or set a strong secret)
ACCESS_KEY_TOKEN=
